{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumi",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // 120 TMDB requests per minute per IP
  "ratelimits": [
    {
      "name": "TMDB_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
