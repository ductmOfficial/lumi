{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumi",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Served at lumi.<subdomain>.workers.dev; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  // The web app's build is served as static assets; unknown paths fall back to index.html.
  // The Worker runs first for the API, the SEO files and every HTML route (to add link-preview metadata).
  // Built files (JS, CSS, images) are excluded and served straight from the assets.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/favicon.svg",
      "!/icons.svg",
      "!/theme-init.js",
      "!/tmdb-logo.svg",
      "!/og-default.png",
    ],
  },
  "vars": {
    "SITE_URL": "https://lumi.tmduc.workers.dev",
  },
  // 120 TMDB requests per minute per IP
  "ratelimits": [
    {
      "name": "TMDB_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
