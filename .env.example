# Local development only. Copy to `.env` in apps/web: cp .env.example apps/web/.env
# TMDB API Read Access Token (v4), from https://www.themoviedb.org/settings/api.
# Dev builds call TMDB directly with it; production builds never contain it and go
# through the Worker proxy, which keeps the token as a secret.
VITE_TMDB_ACCESS_TOKEN=
